{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 300,
  "padding": { "top": 5, "left": 10, "right": 5, "bottom": 5 },
  "params": [
    {
      "name": "YearSelector", "value": 2022,
      "bind": { "input": "select", "options": [2019, 2020, 2022], "name": "Select Year: " }
    }
  ],
  "projection": { "type": "mercator", "center": [108.8, 4.2], "scale": 1500 },
  "layer": [
    {
      "data": { "url": "data/malaysia-states.topojson", "format": { "type": "topojson", "feature": "states" } },
      "mark": { "type": "geoshape", "fill": "#eef3f8", "stroke": "white", "strokeWidth": 1 }
    },
    {
      "data": { "url": "data/visitors_income.csv" },
      "transform": [ { "filter": "datum.year == YearSelector" } ],
      "mark": { "type": "circle", "opacity": 0.8, "stroke": "white", "strokeWidth": 1 },
      "encoding": {
        "longitude": { "field": "longitude", "type": "quantitative" },
        "latitude": { "field": "latitude", "type": "quantitative" },
        "size": {
          "field": "visitors", "type": "quantitative", "title": "Domestic Visitors (Million)",
          "scale": { "range": [50, 1000] },
          "legend": { "orient": "bottom", "direction": "horizontal", "labelFont": "Source Sans 3", "titleFont": "Source Sans 3", "labelFontSize": 11, "titleFontSize": 11 }
        },
        "color": {
          "field": "income", "type": "quantitative", "title": "Monthly Income per Household (RM)",
          "scale": { "scheme": "oranges" },
          "legend": { "orient": "bottom", "direction": "horizontal", "gradientLength": 130, "labelFont": "Source Sans 3", "titleFont": "Source Sans 3", "labelFontSize": 11, "titleFontSize": 11 }
        },
        "tooltip": [
          { "field": "state", "type": "nominal", "title": "State" },
          { "field": "year", "type": "ordinal", "title": "Year" },
          { "field": "visitors", "type": "quantitative", "title": "Domestic Visitors (Million)", "format": ".2f" },
          { "field": "income", "type": "quantitative", "title": "Monthly Income per Household (RM)", "format": ",.0f" }
        ]
      }
    },
    {
      "data": { "values": [{ "text": "High income ≠ high visitors", "longitude": 103.0, "latitude": 6.2 }] },
      "mark": { "type": "text", "font": "Source Sans 3", "fontSize": 11, "fontWeight": "bold", "color": "#19324A", "align": "left" },
      "encoding": {
        "longitude": { "field": "longitude", "type": "quantitative" },
        "latitude": { "field": "latitude", "type": "quantitative" },
        "text": { "field": "text" }
      }
    }
  ],
  "config": {
  "font": "Source Sans 3",

  "axis": {
    "labelFontSize": 13,
    "titleFontSize": 14,
    "labelFont": "Source Sans 3",
    "titleFont": "Source Sans 3"
  },

  "legend": {
    "labelFontSize": 13,
    "titleFontSize": 14,
    "labelFont": "Source Sans 3",
    "titleFont": "Source Sans 3"
  },

  "header": {
    "labelFontSize": 13,
    "titleFontSize": 14
  },

  "text": {
    "fontSize": 13
  }
},
  "background": "#ffffff"
}