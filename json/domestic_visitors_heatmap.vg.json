{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 260,
  "data": { "url": "data/domestic_visitors_quarter.csv" },
  "transform": [
    { "calculate": "'Q' + datum.quarter", "as": "Quarter" },
    { "calculate": "toString(datum.year)", "as": "Year" }
  ],
  "layer": [
    {
      "mark": { "type": "rect", "stroke": "white", "strokeWidth": 1.5 },
      "encoding": {
        "x": {
          "field": "Quarter", "type": "ordinal", "title": "Quarter",
          "sort": ["Q1", "Q2", "Q3", "Q4"],
          "axis": { "labelAngle": 0, "labelFont": "Source Sans 3", "titleFont": "Source Sans 3", "labelFontSize": 12, "titleFontSize": 12, "labelFontWeight": 600 }
        },
        "y": {
          "field": "Year", "type": "ordinal", "title": "Year", "sort": "ascending",
          "axis": { "labelFont": "Source Sans 3", "titleFont": "Source Sans 3", "labelFontSize": 12, "titleFontSize": 12, "labelFontWeight": 600 }
        },
        "color": {
          "field": "domestic_visitors", "type": "quantitative", "title": "Visitors (Million)",
          "scale": { "scheme": "blues", "domain": [0, 75] },
          "legend": {
            "orient": "bottom", "direction": "horizontal", "title": "Visitors (Million)",
            "labelFont": "Source Sans 3", "titleFont": "Source Sans 3",
            "labelFontSize": 11, "titleFontSize": 11, "gradientLength": 220, "gradientThickness": 12
          }
        },
        "tooltip": [
          { "field": "Year", "type": "ordinal", "title": "Year" },
          { "field": "Quarter", "type": "ordinal", "title": "Quarter" },
          { "field": "domestic_visitors", "type": "quantitative", "title": "Domestic Visitors (Million)", "format": ".1f" }
        ]
      }
    },
    {
      "mark": { "type": "text", "font": "Source Sans 3", "fontSize": 12, "fontWeight": 700 },
      "encoding": {
        "x": { "field": "Quarter", "type": "ordinal", "sort": ["Q1", "Q2", "Q3", "Q4"] },
        "y": { "field": "Year", "type": "ordinal", "sort": "ascending" },
        "text": { "field": "domestic_visitors", "type": "quantitative", "format": ".0f" },
        "color": {
          "condition": { "test": "datum.domestic_visitors > 40", "value": "white" },
          "value": "#1a1a2e"
        }
      }
    },
    {
      "data": {
        "values": [
          { "Quarter": "Q2", "Year": "2025", "annotation": "▲ PEAK" },
          { "Quarter": "Q4", "Year": "2025", "annotation": "▲ PEAK" }
        ]
      },
      "mark": {
        "type": "text", "font": "Source Sans 3", "fontSize": 10, "fontWeight": 700,
        "color": "#FFD166", "align": "center", "baseline": "middle", "dy": 14
      },
      "encoding": {
        "x": { "field": "Quarter", "type": "ordinal" },
        "y": { "field": "Year", "type": "ordinal" },
        "text": { "field": "annotation" }
      }
    }
  ],
  "config": {
  "font": "Source Sans 3",

  "axis": {
    "labelFontSize": 13,
    "titleFontSize": 14,
    "labelFont": "Source Sans 3",
    "titleFont": "Source Sans 3"
  },

  "legend": {
    "labelFontSize": 13,
    "titleFontSize": 14,
    "labelFont": "Source Sans 3",
    "titleFont": "Source Sans 3"
  },

  "header": {
    "labelFontSize": 13,
    "titleFontSize": 14
  },

  "text": {
    "fontSize": 13
  }
},
  "background": "#ffffff"
}